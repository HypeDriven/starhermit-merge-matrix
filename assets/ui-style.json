      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$panel2",
        "style": "solid"
      },
      "radius": 18,
      "padding": 20
    },
    ".score-row": {
      "border": {
        "width": {
          "bottom": 1
        },
        "color": {
          "bottom": "$panel2"
        },
        "style": "solid"
      },
      "radius": 0,
      "padding": {
        "top": 6,
        "end": 13,
        "bottom": 6,
        "start": 13
      }
    },
    ".score-total": {
      "radius": 0,
      "padding": {
        "top": 6,
        "end": 13,
        "bottom": 6,
        "start": 13
      }
