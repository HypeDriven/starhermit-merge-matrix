    ".page": {
      "background": "$bg",
      "radius": 0
    },
    ".scrim": {
      "background": "$scrim",
      "radius": 0
    },
    ".dim": {
      "background": "#00000066",
      "radius": 0
    },
    ".topbar": {
      "background": "$panel",
      "border": {
        "width": {
          "bottom": 1
        },
        "color": {
          "bottom": "$panel2"
        },
        "style": "solid"
      },
      "radius": 0,
      "padding": {
        "top": 8,
        "end": 16,
        "bottom": 8,
        "start": 16
      }
    },
    ".title-art": {
      "background": [
        {
          "type": "radial",
          "center": {
            "x": 0.5,
            "y": 0.22
          },
          "stops": [
            "#41d9c01a",
            {
              "color": "#00000000",
              "at": 0.6
            }
          ]
        },
        {
          "image": "assets/title-keyart.webp",
          "size": "cover",
          "repeat": true
        },
        "$bg"
      ],
      "radius": 18,
      "shadow": {
        "y": -60,
        "blur": 60,
        "spread": -30,
        "color": "$bg",
        "inset": true
      },
      "padding": {
        "top": 8,
        "end": 0,
        "bottom": 16,
        "start": 0
      }
    },
    ".title-art-plain": {
      "background": "$bg",
      "radius": 18,
      "padding": {
        "top": 8,
        "end": 0,
        "bottom": 16,
        "start": 0
      }
    },
    ".results-art": {
      "background": [
        {
          "type": "linear",
          "stops": [
            "#0a0e1ab3",
            {
              "color": "$bg",
              "at": 0.66
            }
          ]
        },
        {
          "image": "assets/results-backdrop.webp",
          "size": "cover",
          "position": {
            "x": 0.5,
            "y": 0
          },
          "repeat": true
        }
      ],
      "radius": 18,
      "padding": 16
    },
    ".results-plain": {
      "background": "$bg",
      "radius": 18,
      "padding": 16
    },
    ".hero": {
      "background": "$panel2",
      "radius": 10
    },
    ".panel": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$panel2",
        "style": "solid"
      },
      "radius": 14,
      "padding": 16
    },
    ".panel-warn": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$danger",
        "style": "solid"
