        "end": 13,
        "bottom": 5,
        "start": 13
      }
    },
    ".toast": {
      "background": "$panel2",
      "border": {
        "width": 1,
        "color": "$accent",
        "style": "solid"
      },
      "radius": 10,
      "shadow": {
        "y": 6,
        "blur": 20,
        "color": "#00000073"
      },
      "padding": {
        "top": 10,
        "end": 16,
        "bottom": 10,
        "start": 16
      }
    },
    ".btn": {
      "background": "$panel2",
      "border": {
        "width": 1,
        "color": "$panel2",
        "style": "solid"
      },
      "radius": 12,
      "padding": {
        "top": 13,
        "end": 18,
        "bottom": 13,
        "start": 18
      },
      "minHeight": 44,
      "text": {
        "color": "$text",
        "size": 16,
        "align": "start"
      },
      "hovered": {
        "border": {
          "width": 1,
          "color": "$accent",
          "style": "solid"
        }
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      },
      "disabled": {
        "opacity": 0.5
      }
    },
